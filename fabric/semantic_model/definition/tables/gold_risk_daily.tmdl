	column computed_at_utc
		dataType: dateTime
		formatString: yyyy-mm-dd hh:mm:ss
		lineageTag: b836b26f-3e2c-584d-b98e-e945c1c5d75e
		summarizeBy: none
		sourceColumn: computed_at_utc

	measure 'Scored Days' = CALCULATE(COUNTROWS('gold_risk_daily'), 'gold_risk_daily'[baseline_phase] = "scored", 'gold_risk_daily'[is_observed] = TRUE())
		formatString: #,##0
		lineageTag: 279d4e94-7864-5ca9-b8d2-616530195ecf

	measure 'Observed Days' = CALCULATE(COUNTROWS('gold_risk_daily'), 'gold_risk_daily'[is_observed] = TRUE())
		formatString: #,##0
		lineageTag: b5415937-0480-5687-899d-cc75b8791a8f

	measure 'Data Coverage %' = DIVIDE([Observed Days], COUNTROWS('gold_risk_daily'))
		formatString: 0.0%
		lineageTag: 75bf01b4-c06a-5a70-ac1c-9e11bc48cc0a

	measure 'Red Days' = CALCULATE(COUNTROWS('gold_risk_daily'), 'gold_risk_daily'[risk_tier] = "Red", 'gold_risk_daily'[is_observed] = TRUE())
		formatString: #,##0
		lineageTag: a9624851-7617-5f17-8b16-bb29e6e36970

	measure 'Amber Days' = CALCULATE(COUNTROWS('gold_risk_daily'), 'gold_risk_daily'[risk_tier] = "Amber", 'gold_risk_daily'[is_observed] = TRUE())
		formatString: #,##0
		lineageTag: 0a9668bc-8539-5e58-9f5c-775854ad2292

	measure 'Green Days' = CALCULATE(COUNTROWS('gold_risk_daily'), 'gold_risk_daily'[risk_tier] = "Green", 'gold_risk_daily'[is_observed] = TRUE())
		formatString: #,##0
		lineageTag: b7569b24-cf6d-5107-86f3-eb59c68d734d

	measure 'Excess Value at Risk (USD)' = SUM('gold_risk_daily'[exp_usd])
		formatString: $#,##0
		lineageTag: b40687e2-3fcf-5000-9d8c-afa7665b30f9

	measure 'Deferred Oil (bbl)' = SUM('gold_risk_daily'[deferred_oil])
		formatString: #,##0.0
		lineageTag: fda8904e-bda6-5c0a-8ec7-32257cc24b16

	measure 'Latest Risk Score' = VAR d = CALCULATE(MAX('gold_risk_daily'[date]), 'gold_risk_daily'[is_observed] = TRUE()) RETURN CALCULATE(MAX('gold_risk_daily'[risk_score]), 'gold_df_dim_date'[date] = d)
		formatString: 0.000
		lineageTag: 1c2311e7-27e6-578a-b2ac-1de897b783db

	measure 'Risk Score' = MAX('gold_risk_daily'[risk_score])
		formatString: 0.000
		lineageTag: 959ac938-4873-566d-a0e0-0977caeca958

	measure 'Latest Risk Tier' = VAR d = CALCULATE(MAX('gold_risk_daily'[date]), 'gold_risk_daily'[is_observed] = TRUE()) RETURN CALCULATE(FIRSTNONBLANK('gold_risk_daily'[risk_tier], 1), 'gold_df_dim_date'[date] = d, 'gold_risk_daily'[is_observed] = TRUE())
		lineageTag: 76b25107-48a6-5002-9255-3499a87768b1

	measure 'Stations at Red (latest)' = VAR d = CALCULATE(MAX('gold_risk_daily'[date]), 'gold_risk_daily'[is_observed] = TRUE()) RETURN COALESCE(CALCULATE(DISTINCTCOUNT('gold_risk_daily'[station_id]), 'gold_df_dim_date'[date] = d, 'gold_risk_daily'[risk_tier] = "Red"), 0)
		formatString: #,##0
		lineageTag: c0081ff2-4dd4-555e-8d00-4229704f70e8

	measure 'Latest Observed Date' = CALCULATE(MAX('gold_risk_daily'[date]), 'gold_risk_daily'[is_observed] = TRUE())
		formatString: yyyy-mm-dd
		lineageTag: 3a5710d5-42d1-5dba-97c3-7b4cf09ea03a

	partition gold_risk_daily = entity
		mode: directLake
		source
			entityName: gold_risk_daily
			expressionSource: DatabaseQuery
