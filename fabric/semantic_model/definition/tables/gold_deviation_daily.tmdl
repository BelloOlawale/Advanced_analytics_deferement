		sourceColumn: baseline_phase

	measure 'Bad Z' = AVERAGEX('gold_deviation_daily', IF('gold_deviation_daily'[higher_is_bad], 'gold_deviation_daily'[robust_z], -'gold_deviation_daily'[robust_z]))
		formatString: 0.00
		lineageTag: 0b8f9b37-02c8-5aeb-9678-e0fabb9ef9c2

	measure 'Actual Oil' = CALCULATE(SUM('gold_deviation_daily'[value]), 'gold_deviation_daily'[metric] = "oil")
		formatString: #,##0.0
		lineageTag: a0895276-c74f-5389-9571-edbf2146a974

	measure 'Expected Oil' = CALCULATE(SUM('gold_deviation_daily'[expected]), 'gold_deviation_daily'[metric] = "oil")
		formatString: #,##0.0
		lineageTag: 48e976d5-1779-5c6d-a2b9-2b05176d99b2

	measure 'Bad Z (scored)' = CALCULATE([Bad Z], 'gold_deviation_daily'[baseline_phase] = "scored")
		formatString: 0.00
		lineageTag: 55681aaf-dda3-5582-ae79-dc5eceb0c78e

	measure 'Max Bad Z (scored)' = CALCULATE(MAXX('gold_deviation_daily', IF('gold_deviation_daily'[higher_is_bad], 'gold_deviation_daily'[robust_z], -'gold_deviation_daily'[robust_z])), 'gold_deviation_daily'[baseline_phase] = "scored")
		formatString: 0.00
		lineageTag: e8eaa4e8-751c-57bf-820d-4f6a6876501f

	partition gold_deviation_daily = entity
		mode: directLake
		source
			entityName: gold_deviation_daily
			expressionSource: DatabaseQuery
