		summarizeBy: none
		sourceColumn: alert_status

	column notification_channel
		dataType: string
		lineageTag: 8b42f644-bdc7-522e-adb4-cc7372c7984a
		summarizeBy: none
		sourceColumn: notification_channel

	column notification_target
		dataType: string
		lineageTag: 970c4402-85de-53f3-a8dd-94228dea265e
		summarizeBy: none
		sourceColumn: notification_target

	measure 'Alerts Fired' = COUNTROWS('gold_alert')
		formatString: #,##0
		lineageTag: 01746caa-1f9b-538c-8876-3c47d2ed7a09

	measure 'Red Alerts' = CALCULATE(COUNTROWS('gold_alert'), 'gold_alert'[tier] = "Red")
		formatString: #,##0
		lineageTag: 8d8a5909-5ac2-5f30-8d4a-f6dd1acfdda8

	measure 'Amber Alerts' = CALCULATE(COUNTROWS('gold_alert'), 'gold_alert'[tier] = "Amber")
		formatString: #,##0
		lineageTag: dc8c26d5-e173-507f-be41-97b0eadc6d78

	measure 'Open Alerts' = CALCULATE(COUNTROWS('gold_alert'), NOT('gold_alert'[alert_status] IN {"Closed", "Resolved", "Dismissed"}))
		formatString: #,##0
		lineageTag: 1d5037d7-a4e8-5faa-b9a9-5eab1087fe16

	measure 'Excess USD at Alert' = SUM('gold_alert'[exp_usd])
		formatString: $#,##0
		lineageTag: 56d66f72-cd82-5d9b-a596-7a479010661a

	measure 'Largest Alert (USD)' = MAX('gold_alert'[exp_usd])
		formatString: $#,##0
		lineageTag: ee749fe6-e607-5acc-b0bd-8ad914c96186

	measure 'Alerted Stations' = DISTINCTCOUNT('gold_alert'[station_id])
		formatString: #,##0
		lineageTag: 4f31f19b-552e-5934-9d53-aa441d60742b

	measure 'Alert Rate per Station per Week' = VAR n_alerts = COUNTROWS('gold_alert') VAR n_stations = DISTINCTCOUNT('gold_alert'[station_id]) VAR first_d = MIN('gold_alert'[alert_date]) VAR last_d = MAX('gold_alert'[alert_date]) VAR days = DATEDIFF(first_d, last_d, DAY) + 1 RETURN DIVIDE(n_alerts, n_stations * DIVIDE(days, 7))
		formatString: 0.00
		lineageTag: a081e0cf-55a2-52df-b7d9-bdb79f43697b

	partition gold_alert = entity
		mode: directLake
		source
			entityName: gold_alert
			expressionSource: DatabaseQuery
