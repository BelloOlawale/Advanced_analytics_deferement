{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.2.0/schema.json",
  "name": "rank_station",
  "position": {
    "x": 20,
    "y": 215,
    "z": 2000,
    "height": 330,
    "width": 580,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_df_dim_station"
                    }
                  },
                  "Property": "station_name"
                }
              },
              "queryRef": "gold_df_dim_station.station_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_risk_daily"
                    }
                  },
                  "Property": "Excess Value at Risk (USD)"
                }
              },
              "queryRef": "gold_risk_daily.Excess Value at Risk (USD)"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "gold_risk_daily"
                  }
                },
                "Property": "Excess Value at Risk (USD)"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Excess value at risk by station'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "'12'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}