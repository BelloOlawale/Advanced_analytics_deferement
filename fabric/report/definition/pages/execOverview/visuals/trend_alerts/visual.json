{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.2.0/schema.json",
  "name": "trend_alerts",
  "position": {
    "x": 20,
    "y": 560,
    "z": 2300,
    "height": 145,
    "width": 1240,
    "tabOrder": 2300
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_df_dim_date"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "gold_df_dim_date.date",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_alert"
                    }
                  },
                  "Property": "tier"
                }
              },
              "queryRef": "gold_alert.tier"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_alert"
                    }
                  },
                  "Property": "Alerts Fired"
                }
              },
              "queryRef": "gold_alert.Alerts Fired"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Alerts by date and tier'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "'11'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}