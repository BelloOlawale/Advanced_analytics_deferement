{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.2.0/schema.json",
  "name": "st_oil_line",
  "position": {
    "x": 650,
    "y": 240,
    "z": 2100,
    "height": 210,
    "width": 610,
    "tabOrder": 2100
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_df_dim_date"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "gold_df_dim_date.date",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_deviation_daily"
                    }
                  },
                  "Property": "Actual Oil"
                }
              },
              "queryRef": "gold_deviation_daily.Actual Oil"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold_deviation_daily"
                    }
                  },
                  "Property": "Expected Oil"
                }
              },
              "queryRef": "gold_deviation_daily.Expected Oil"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Oil: actual vs expected'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "'12'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}