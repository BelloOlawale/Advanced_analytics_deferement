# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored, so secrets here never reach GitHub.
#
# EASIEST AUTH: sign in to the NewCross tenant first, then leave AUTH=default
#   az login --tenant <newcross-tenant-id>
# and set only SERVER + DATABASE below.
#
# LEAST-PRIVILEGE AUTH (recommended): a read-only service principal.
#   Set AUTH=sp and fill UID (client id) + PWD (client secret) + TENANT.

# --- required ---
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=

# --- auth ---
# default | sp | interactive | devicecode | msi
FABRIC_SQL_AUTH=default
# FABRIC_SQL_UID=
# FABRIC_SQL_PWD=
# FABRIC_SQL_TENANT=

# --- optional ---
# FABRIC_QUERY_TIMEOUT=300
# FABRIC_SQL_CONN=   # a full connection string overrides everything above

# --- examples ---
# server (Fabric Warehouse "SQL connection string" box, just the Server= part):
#   mywh@myworkspace.datawarehouse.fabric.microsoft.com
# database (usually the warehouse name):
#   mywh
