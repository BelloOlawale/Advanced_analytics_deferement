# ---------------------------------------------------------------------------
# Fabric environment profiles
#
# Use ONE file per environment. Copy this file, then rename it:
#
#   .env              -> local (default; the old behaviour)
#   .env.sandbox      -> new/test tenant
#   .env.customer     -> the customer tenant
#
# Select a profile with `FABRIC_ENV` or `--env`:
#
#   python tools/fabric_query.py --env sandbox --test
#   python tools/fabric_query.py --env sandbox --show-env
#
# Profiles do NOT layer. Only the selected file is loaded, so a sandbox
# run can never accidentally pick up the customer's server.
#
# `.env*` is git-ignored (except this example). Never commit secrets.
# ---------------------------------------------------------------------------

# --- required: which warehouse to read ---
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=

# --- optional: environment identity (safe to commit; no secrets) ---
# Useful for scripts and for knowing which build this profile targets.
# FABRIC_WORKSPACE_NAME=
# FABRIC_WORKSPACE_ID=
# FABRIC_CAPACITY_NAME=
# FABRIC_CAPACITY_ID=
# FABRIC_CAPACITY_SKU=       # F2 | F16 | ...
# FABRIC_CAPACITY_REGION=

# --- auth ---
# default | sp | interactive | devicecode | msi
FABRIC_SQL_AUTH=default
# FABRIC_SQL_UID=
# FABRIC_SQL_PWD=
# FABRIC_SQL_TENANT=

# --- optional ---
# FABRIC_QUERY_TIMEOUT=300
# FABRIC_SQL_CONN=   # a full connection string overrides everything above

# --- optional: isolated login cache per tenant ---
# Leave unset and the tool uses ~/.azure-fabric/<profile>
# AZURE_CONFIG_DIR=

# ===========================================================================
# EXAMPLES
# ===========================================================================
#
# .env.sandbox (new tenant):
#   FABRIC_WORKSPACE_NAME=maf
#   FABRIC_WORKSPACE_ID=<workspace-guid>
#   FABRIC_CAPACITY_NAME=mafcapacity
#   FABRIC_CAPACITY_SKU=F2
#   FABRIC_CAPACITY_REGION=North Europe
#   FABRIC_SQL_SERVER=<warehouse>@<workspace>.datawarehouse.fabric.microsoft.com
#   FABRIC_SQL_DATABASE=<warehouse-name>
#   FABRIC_SQL_AUTH=default
#   FABRIC_SQL_TENANT=<new-tenant-id>
#
# .env.customer (NewCross):
#   FABRIC_SQL_SERVER=...
#   FABRIC_SQL_DATABASE=wh_gold
#   FABRIC_SQL_AUTH=default
#   FABRIC_SQL_TENANT=<newcross-tenant-id>
#   AZURE_CONFIG_DIR=C:/Users/<you>/.azure-newcross
#
# EASIEST AUTH: sign in to that tenant first, then leave AUTH=default:
#   az login --tenant <tenant-id>
#
# LEAST-PRIVILEGE AUTH: a read-only service principal.
#   AUTH=sp, UID (client id), PWD (client secret), TENANT.
